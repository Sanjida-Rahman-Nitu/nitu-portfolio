# Copy this file to .env.local for local development,
# and add the same variables in Vercel → Project → Settings → Environment Variables.

# Public URL of the deployed site (used for SEO tags, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://sanjida-nitu.vercel.app

# Contact form (optional). Without these, the form tells visitors to email you directly.
# Get a free API key at https://resend.com
RESEND_API_KEY=
# The inbox that should receive contact-form messages
CONTACT_TO_EMAIL=
